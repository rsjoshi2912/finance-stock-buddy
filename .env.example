# Local sample data is the default. Use a DIFFERENT database for live observations.
APP_MODE=demo
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/nifty_signal?sslmode=require
# DATABASE_URL=sqlite:///data/live.db

# Required by the app in live mode. Bind the backend to 127.0.0.1.
OWNER_USER=ravi
OWNER_PASSWORD=

# Sending remains off until explicitly enabled by the owner.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_TOKEN_CAP=12000
UPSTOX_ACCESS_TOKEN=
# Public data works without a broker key. Change to upstox when ready.
MARKET_DATA_PROVIDER=yfinance
NEWS_ENABLED=true
NEWS_FEEDS=et-markets,mint-markets,mint-companies,rbi
# Exact origin only, no repository path and no wildcard.
FRONTEND_ORIGINS=

# No runtime AI provider is selected or contacted in this version.
