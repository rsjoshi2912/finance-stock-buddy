[Unit]
Description=Nifty Signal live scheduler and market feed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nifty
WorkingDirectory=/opt/finance-stock-buddy/backend
EnvironmentFile=/opt/finance-stock-buddy/.env
ExecStart=/opt/finance-stock-buddy/.venv/bin/python -m app.scheduler
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/finance-stock-buddy/data

[Install]
WantedBy=multi-user.target
