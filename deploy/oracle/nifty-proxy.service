[Unit]
Description=Nifty Signal HTTPS
After=network-online.target nifty-api.service
Wants=network-online.target

[Service]
Type=notify
User=opc
Group=opc
WorkingDirectory=/opt/finance-stock-buddy
Environment=XDG_DATA_HOME=/opt/finance-stock-buddy/data/caddy
Environment=XDG_CONFIG_HOME=/opt/finance-stock-buddy/data/caddy-config
ExecStart=/opt/finance-stock-buddy/.runtime/caddy run --config /opt/finance-stock-buddy/deploy/oracle/Caddyfile --adapter caddyfile
ExecReload=/opt/finance-stock-buddy/.runtime/caddy reload --config /opt/finance-stock-buddy/deploy/oracle/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/finance-stock-buddy/data

[Install]
WantedBy=multi-user.target
