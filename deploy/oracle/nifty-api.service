[Unit]
Description=Nifty Signal private API
After=network-online.target
Wants=network-online.target

[Service]
User=opc
Group=opc
WorkingDirectory=/opt/finance-stock-buddy/backend
EnvironmentFile=/opt/finance-stock-buddy/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/finance-stock-buddy/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/finance-stock-buddy/data

[Install]
WantedBy=multi-user.target
