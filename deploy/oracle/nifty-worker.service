[Unit]
Description=Nifty Signal live market worker
After=network-online.target nifty-api.service
Wants=network-online.target

[Service]
User=opc
Group=opc
WorkingDirectory=/opt/finance-stock-buddy/backend
EnvironmentFile=/opt/finance-stock-buddy/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/finance-stock-buddy/.venv/bin/python -m app.scheduler
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/finance-stock-buddy/data

[Install]
WantedBy=multi-user.target
