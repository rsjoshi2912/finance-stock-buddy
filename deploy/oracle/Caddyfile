{
    # Browsers and curl send no SNI when connecting to a bare IP, and behind Oracle's NAT the
    # listener's own address is a private one. Without this, Caddy cannot select the certificate.
    default_sni 130.210.23.30
}

https://130.210.23.30 {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
